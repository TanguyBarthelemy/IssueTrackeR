linters: lintr::all_linters(
        indentation_linter = lintr::indentation_linter(indent = 4L),
        line_length_linter = lintr::line_length_linter(80L),
        undesirable_function_linter = lintr::undesirable_function_linter(symbol_is_undesirable = FALSE),
        return_linter = NULL,
        object_name_linter = NULL
    )
encoding: "UTF-8"
exclusions: list(
    "tests" = list(
        undesirable_operator_linter = Inf
    )
  )
